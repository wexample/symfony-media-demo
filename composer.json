{
  "name": "wexample/symfony-media-demo",
  "description": "Demo of symfony-media: the library, and an article picking its cover and its attachments in it",
  "version": "3.0.9",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMediaDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=40.0.0",
    "wexample/symfony-forms": ">=14.0.2",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-loader": ">=25.3.0",
    "wexample/symfony-media": ">=6.0.0",
    "wexample/symfony-media-ds": ">=3.0.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}