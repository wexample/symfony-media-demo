{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <p class="text-secondary">{{ '@page::intro' | trans }}</p>
    <p>
        {{ text_link(path('media_library_index'), '@page::library' | trans) }}
        ·
        {{ text_link(path('media_demo_article', { id: article.id }), '@page::edit' | trans) }}
    </p>

    {#- What the article holds, read through its relations: the library
        serves the files behind its access check. -#}
    <div class="block block--padded">
        <h2>{{ article.title }}</h2>
        {%- if article.cover -%}
            <img src="{{ path('media_thumbnail', { id: article.cover.id, width: 480 }) }}" alt="{{ article.cover.name }}" class="media-demo--cover">
        {%- else -%}
            <p class="text-secondary">{{ '@page::no_cover' | trans }}</p>
        {%- endif -%}
        <h3>{{ '@page::attachments' | trans }}</h3>
        {%- if article.attachments is empty -%}
            <p class="text-secondary">{{ '@page::no_attachments' | trans }}</p>
        {%- else -%}
            <ul>
                {%- for media in article.attachments -%}
                    <li>{{ text_link(path('media_file', { id: media.id }), media.name) }}</li>
                {%- endfor -%}
            </ul>
        {%- endif -%}
    </div>
{%- endblock -%}
