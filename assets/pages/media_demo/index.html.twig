{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- What the page leads to, in its title bar: the library, where a page of
    the application opens — a modal, a panel, as the tunnels of the demo do —,
    and the article's form. -#}
{%- block page_title_actions -%}
    {%- set overlay_options = { closeOnEscape: true, closeOnOverlayClick: true, resizable: true, resizeState: 'media-library' } -%}
    {{ button_link('ph:bold/pencil-simple', '@page::edit' | trans, path('media_demo_article', { id: article.id }), { class: 'button' }) }}
    {{ button_target('ph:bold/app-window', 'WexampleSymfonyMediaDemoBundle.pages.media_demo.index::open.modal', path('media_library_index'), 'modal', { class: 'button', target_options: overlay_options }) }}
    {{ button_target('ph:bold/sidebar-simple-duotone', 'WexampleSymfonyMediaDemoBundle.pages.media_demo.index::open.panel', path('media_library_index'), 'panel', { class: 'button', target_options: overlay_options }) }}
{%- endblock -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {#- What the article holds, read through its relations: the library
        serves the files behind its access check. -#}
    <article class="block block--card media-demo--article">
        {%- if article.cover -%}
            <div class="media media--16-9 media--cover">
                <img src="{{ path('media_thumbnail', { id: article.cover.id, width: 480 }) }}" alt="{{ article.cover.name }}">
            </div>
        {%- endif -%}
        <div class="block--body">
            <h2>{{ article.title }}</h2>
            {%- if not article.cover -%}
                <p class="text-secondary">{{ '@page::no_cover' | trans }}</p>
            {%- endif -%}
        </div>
    </article>

    {#- The attachments, as the design system draws files. -#}
    {{ file_explorer(
        article.attachments.toArray|map(media => {
            name: media.name,
            type: 'file',
            size: media.size,
            modifiedAt: media.dateCreated,
            href: path('media_file', { id: media.id }),
        }),
        [],
        { title: '@page::attachments' | trans }
    ) }}
{%- endblock -%}
