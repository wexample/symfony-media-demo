{
  "name": "wexample/symfony-media-demo",
  "description": "Demo of symfony-media: the library, and an article picking its cover and its attachments in it",
  "version": "2.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMediaDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=35.0.0",
    "wexample/symfony-forms": ">=12.0.0",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-loader": ">=23.0.0",
    "wexample/symfony-media": ">=2.0.0",
    "wexample/symfony-media-ds": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}